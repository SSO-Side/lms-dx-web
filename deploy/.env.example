# 서버의 deploy/.env로 복사해 값을 채운다 (.env는 git에 올리지 않는다)

# compose 설정
# 기존 MariaDB 컨테이너가 붙어 있는 Docker 네트워크 이름 (docker inspect <컨테이너> 로 확인)
DB_NETWORK=""
# 업로드 파일(증빙·이력서·과제)을 둘 호스트 경로. 컨테이너 사용자(uid 1000)가 쓸 수 있어야 한다.
STORAGE_HOST_DIR="/srv/lms-kdt/storage"
APP_PORT="3333"

# DB: 호스트 자리는 기존 MariaDB 컨테이너 이름. 이 DB에만 권한이 있는 전용 계정을 쓴다.
DATABASE_URL="mysql://USER:PASSWORD@MARIADB_CONTAINER:3306/lms_kdt_staging"

# 앱
APP_BASE_URL="https://staging.example.com"
# 32자 이상 무작위 값 (예: openssl rand -base64 48)
SESSION_SECRET=""
# Nginx가 파일을 직접 보낼 때만 "/_files" (deploy/nginx.conf.example 참고). 비워 두면 앱이 직접 보낸다.
STORAGE_ACCEL_PREFIX=""
STORAGE_DRIVER="local"

# AI 서비스 (키를 받기 전까지 목 사용)
USE_AI_MOCK="true"
CHATBOT_API_URL=""
CHATBOT_SERVICE_TOKEN=""
INTERVIEW_API_URL=""
INTERVIEW_SERVICE_TOKEN=""

# 시드: 평소엔 false. 가상 데이터 시드 때만 실행 명령에서 ALLOW_SEED=true로 덮어쓴다.
ALLOW_SEED="false"
SEED_PASSWORD=""

# 스테이징은 검색 노출 차단 (비워 둠)
MARKET_INDEXABLE=""
