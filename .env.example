# 값은 .env에 넣는다 (.env는 git에 올리지 않는다)

# DB (MariaDB, Prisma mysql 프로바이더)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/lms_kdt"
# prisma migrate dev 용 섀도 DB (빈 DB를 하나 더 만들고 같은 계정에 권한 부여)
SHADOW_DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/lms_kdt_shadow"

# 앱
APP_BASE_URL="http://localhost:3000"
SESSION_SECRET=""
TZ="Asia/Seoul"
STORAGE_DIR="./.storage"

# AI 서비스 (개발 중에는 목 사용)
USE_AI_MOCK="true"
CHATBOT_API_URL=""
CHATBOT_SERVICE_TOKEN=""
INTERVIEW_API_URL=""
INTERVIEW_SERVICE_TOKEN=""

# 시드 (개발 DB에서만)
ALLOW_SEED="false"
SEED_PASSWORD=""
